# ==============================================================================
# Bank Event Gateway - Environment Configuration Example
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=8090
HOST=0.0.0.0
LOG_LEVEL=info

# Master Encryption Key (Used for AES-256-GCM encryption of endpoint secrets)
# Generate with: openssl rand -hex 32
APP_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Path
DATABASE_PATH=./data/gateway.db

# Gmail & Google Cloud Pub/Sub Configuration
GMAIL_MAILBOX_ID=me
GMAIL_CREDENTIALS_PATH=./credentials/gmail-credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail-token.json
PUBSUB_CREDENTIALS_PATH=./credentials/pubsub-sa.json
PUBSUB_SUBSCRIPTION_NAME=projects/my-gcp-project/subscriptions/bank-email-sub
PUBSUB_TOPIC_NAME=projects/my-gcp-project/topics/bank-email-topic

# Bank Authentication & Filtering
ALLOWED_BANK_DOMAINS=acb.com.vn
# Optional: comma-separated account whitelist (leave empty to accept all accounts)
ALLOWED_RECEIVER_ACCOUNTS=
# Optional: ISO date string cutoff (messages before this date will be ignored)
INGEST_START_AT=2026-09-01T00:00:00.000Z

# Timing & Safety Limits
RECONCILE_INTERVAL_SECONDS=60
WATCH_RENEW_INTERVAL_HOURS=12
WEBHOOK_TIMEOUT_MS=10000
MAX_RETRY_ATTEMPTS=20
MAX_RETRY_DURATION_HOURS=48

# Cloudflare Access origin assertion validation
# Set these to the Access team and application audience created during infrastructure setup.
# No Cloudflare API token belongs in this runtime file for application authentication.
CLOUDFLARE_ACCESS_TEAM_NAME=thedemontuan
CLOUDFLARE_ACCESS_AUD=replace-with-cloudflare-access-application-audience

# Dedicated tunnel runtime credential. Keep this only on the VPS.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-dedicated-tunnel-token
