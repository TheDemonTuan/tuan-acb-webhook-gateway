# TuanBankGateway v2 production configuration — replace every placeholder.
APP_ENV=production
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data
DATABASE_PATH=/data/gateway.db
TZ=Asia/Ho_Chi_Minh
DEFAULT_POLL_INTERVAL_SEC=15
FAST_POLL_INTERVAL_SEC=5

# Create a base64-raw 32-byte key in the mounted file; mode 0600.
APP_MASTER_KEY_FILE=/run/secrets/app_master_key

# Cloudflare Access. The backend validates issuer, audience, expiry, nbf and JWKS.
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-access-application-audience
CF_ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs

# Comma-separated Cloudflare JWT subjects, not unverified user-email headers.
OWNER_SUBJECTS=replace-with-owner-subject
OPERATOR_SUBJECTS=
VIEWER_SUBJECTS=

# Tunnel token: provision on VPS secret store, never commit it.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-dedicated-tunnel-token
